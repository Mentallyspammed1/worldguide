{
  "name": "tittyhunter-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Neon Multi-Site Hunter with live hover video preview, favorites, and diagnostics",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx --max-warnings=0",
    "bg": "nohup ./node_modules/.bin/tsx server.ts > server.log 2>&1 & echo $! > server.pid",
    "stop": "if [ -f server.pid ]; then PID=$(cat server.pid); kill $PID 2>/dev/null; pkill -P $PID 2>/dev/null; pkill -f 'tsx server.ts' 2>/dev/null; rm -f server.pid; fi",
    "status": "if [ -f server.pid ] && kill -0 $(cat server.pid) 2>/dev/null; then echo 'Running (PID: $(cat server.pid))'; else echo 'Not running'; fi",
    "logs": "tail -f server.log",
    "restart": "npm run stop && sleep 1 && npm run bg",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
