{
  "name": "pyrmsearch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first PWA for searching public adult-site listings (18+ only)",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "npm run typecheck && vite build",
    "start": "tsx server.ts",
    "preview": "npm run start",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "bg": "node scripts/server-control.mjs start",
    "stop": "node scripts/server-control.mjs stop",
    "status": "node scripts/server-control.mjs status",
    "logs": "tail -n 100 -f server.log",
    "restart": "npm run stop && npm run bg"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.0.0",
    "pino": "^10.4.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^0.546.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
