# Server settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Content-Security-Policy frame-ancestors sources, separated by spaces.
# Keep the default for standalone use. For an embedded Arena preview, allow the
# Arena parent origin explicitly, for example:
# FRAME_ANCESTORS="'self' https://arena.ai https://*.arena.ai"
FRAME_ANCESTORS="'self'"

# Optional extra HTTPS hostnames used by source-site video CDNs.
# Separate hostnames with commas; do not include schemes or paths.
# The media proxy will continue to allow the configured source-site domains.
MEDIA_HOST_ALLOWLIST=
